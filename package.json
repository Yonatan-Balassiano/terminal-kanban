{
  "name": "agentboard",
  "version": "0.1.0",
  "description": "Terminal-native Kanban board for managing AI coding sessions",
  "type": "module",
  "bin": {
    "agentboard": "./dist/bin/agentboard.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "tsx src/bin/agentboard.tsx",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "doctor": "node dist/bin/agentboard.js doctor",
    "reset-deamon": "node dist/bin/agentboard.js daemon stop && node dist/bin/agentboard.js daemon start",
    "reset-daemon": "node dist/bin/agentboard.js daemon stop && node dist/bin/agentboard.js daemon start",
    "demo": "vhs demo/demo.tape",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@xterm/headless": "^5.5.0",
    "better-sqlite3": "^9.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "marked": "^13.0.0",
    "marked-terminal": "^7.2.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
